# MIREC — Supabase yapılandırması
# Bu dosyayı .env.local olarak kopyala ve Supabase proje anahtarlarını gir.
# Anahtarlar boşsa uygulama otomatik olarak "misafir modu"nda (localStorage) çalışır.

NEXT_PUBLIC_SUPABASE_URL=https://XXXX.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Bekleme listesi: sunucu tarafı Supabase yazımı için (Supabase panelinden)
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# İsteğe bağlı: kayıtları Brevo listesine de ekle (hoş geldin e-postası Brevo'da kurulur)
# BREVO_API_KEY=xkeysib-...
# BREVO_LIST_ID=2

# fal.ai — gerçek görsel/video üretimi (yoksa uygulama simülasyonla çalışır)
FAL_API_KEY=key_id:key_secret
# İsteğe bağlı model override'ları (varsayılanlar lib/fal.js içinde):
# FAL_MODEL_KLING_T2V=fal-ai/kling-video/v2.5-turbo/pro/text-to-video
# FAL_MODEL_SEEDANCE_T2V=fal-ai/bytedance/seedance/v1/pro/text-to-video
# FAL_MODEL_PORTRAIT=fal-ai/flux/schnell

# Senaryo Agentı (sunucu tarafı — tarayıcıya gitmez; .env dosyasına da konabilir)
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini   # varsayılan
